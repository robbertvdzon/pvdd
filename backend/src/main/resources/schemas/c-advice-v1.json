{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvdd.vdzonsoftware.nl/schemas/c-advice-v1.json",
  "title": "PvdD C-agenda-bespreekadvies v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agendaItemSourceId",
    "besprekenEnNaarB",
    "motivering",
    "urgentie",
    "commissieDoel",
    "kernvraag"
  ],
  "properties": {
    "agendaItemSourceId": {"type": "string", "minLength": 1, "maxLength": 160},
    "besprekenEnNaarB": {"type": "boolean"},
    "motivering": {"$ref": "ab-advice-v1.json#/$defs/section"},
    "urgentie": {"enum": ["LAAG", "MIDDEL", "HOOG"]},
    "commissieDoel": {"$ref": "ab-advice-v1.json#/$defs/section"},
    "kernvraag": {
      "oneOf": [
        {"$ref": "ab-advice-v1.json#/$defs/section"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"besprekenEnNaarB": {"const": true}}},
      "then": {"properties": {"kernvraag": {"$ref": "ab-advice-v1.json#/$defs/section"}}}
    }
  ]
}
