{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvdd.vdzonsoftware.nl/schemas/c-advice-v1.json",
  "title": "PvdD C-agenda-bespreekadvies v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agendaItemSourceId",
    "besprekenEnNaarB",
    "motivering",
    "urgentie",
    "commissieDoel",
    "kernvraag"
  ],
  "properties": {
    "agendaItemSourceId": {"type": "string", "minLength": 1, "maxLength": 160},
    "besprekenEnNaarB": {"type": "boolean"},
    "motivering": {"$ref": "#/$defs/section"},
    "urgentie": {"enum": ["LAAG", "MIDDEL", "HOOG"]},
    "commissieDoel": {"$ref": "#/$defs/section"},
    "kernvraag": {
      "oneOf": [
        {"$ref": "#/$defs/section"},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"besprekenEnNaarB": {"const": true}}},
      "then": {"properties": {"kernvraag": {"$ref": "#/$defs/section"}}}
    }
  ],
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citations"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 6000},
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/citation"}
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceType", "quote"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1, "maxLength": 160},
        "sourceType": {"enum": ["MEETING_DOCUMENT", "POLICY_PROGRAMME"]},
        "pageNumber": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": ["string", "null"], "maxLength": 200},
        "quote": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
