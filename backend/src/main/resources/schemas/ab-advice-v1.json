          "type": "object", "additionalProperties": false, "required": ["sourceId", "sourceType", "quote"],
          "properties": {
            "sourceId": {"type": "string", "minLength": 1, "maxLength": 160},
            "sourceType": {"enum": ["MEETING_DOCUMENT", "POLICY_PROGRAMME"]},
