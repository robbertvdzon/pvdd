  "title": "PvdD A/B-agenda-advies v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["agendaItemSourceId", "waarGaatHetOver", "watVindenWeErvan", "commissieInzet", "puntenVoorGedeputeerde", "technischeVragen"],
